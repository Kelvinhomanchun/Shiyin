      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The final meeting notes are ready. The draft you edited is kept in the version history; use Restore previous version next to Edit on the Notes tab to get it back"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正式版的会议记录好了；你改过的草稿留在版本记录里，按记录标签页“编辑”旁的“恢复上一版”可以找回"
