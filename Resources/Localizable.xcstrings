        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can open this guide again any time from the Help menu (⌘?) or the KelNote icon in the menu bar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之后随时可以从“辅助说明”菜单（⌘?）或菜单栏的拾音图标，再打开这份说明。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之後隨時可以從「輔助說明」選單（⌘?）或選單列的 KelNote 圖示，再打開這份說明。"
