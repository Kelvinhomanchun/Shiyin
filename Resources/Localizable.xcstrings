        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停麦克风：只录电脑声音（⇧⌘M）。用扬声器开会时避免录到回音，同一个房间的人说话也不会录到"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause the microphone and record only computer audio (⇧⌘M). Avoids recording echo when the meeting plays through speakers; people talking in the same room won't be recorded either"
