          "stringUnit": {
            "state": "translated",
            "value": "Relationships"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "人际关系"
          }
        }
      }
    },
    "今天 %@ 自動停止錄音並轉錄（%@後）。": {
