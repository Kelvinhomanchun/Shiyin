    "開": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开"
          }
        }
      }
    },
    "開 Zoom、Teams、Google Meet 等線上會議時，拾音會提醒你開始錄音（打開錄音島時提醒出現在島上）；會議好像結束時提醒停止。不想被某個 app 提醒，在提醒上按「不要再提醒」。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开 Zoom、Teams、Google Meet 等线上会议时，拾音会提醒你开始录音（打开录音岛时提醒出现在岛上）；会议好像结束时提醒停止。不想被某个 app 提醒，在提醒上按“不要再提醒”。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you join a Zoom, Teams, Google Meet or other online meeting, KelNote asks whether to start recording (on the recording island when it's turned on), and reminds you to stop when the meeting seems to be over. To stop the reminders for an app, click “Don't Ask for This App” on the reminder."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開 Zoom、Teams、Google Meet 等線上會議時，KelNote 會提醒你開始錄音（打開錄音島時提醒出現在島上）；會議好像結束時提醒停止。不想被某個 app 提醒，在提醒上按「不要再提醒」。"
          }
        }
      }
    },
