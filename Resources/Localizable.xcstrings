          }
        }
      }
    },
    "依會議紀錄畫成心智圖。PNG 適合貼到聊天軟體、簡報；SVG 可以再用其他軟體編輯。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draws the meeting notes as a mind map. PNG works well in chats and slides; SVG can be edited in other apps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "依会议记录画成心智图。PNG 适合贴到聊天软件、演示文稿；SVG 可以再用其他软件编辑。"
          }
        }
      }
    },
    "依月份": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按月份"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By Month"
          }
        }
      }
    },
    "依詞彙表和上下文找出可能聽錯的字，標在逐字稿裡，你決定要不要改。不會自動改掉原文。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finds words that were probably misheard, using the glossary and context, and marks them in the transcript for you to decide. The original text is never changed automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "依词汇表和上下文找出可能听错的字，标在逐字稿里，你决定要不要改。不会自动改掉原文。"
          }
        }
      }
    },
    "依詞處理（%lld 組）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Review by word (%lld group)"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Review by word (%lld groups)"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "依词处理（%lld 组）"
          }
        }
      }
    },
    "依資料夾": {
