            "value": "Recording source"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音来源"
          }
        }
      }
    },
    "錄音來源、麥克風、會議語言": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音来源、麦克风、会议语言"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording source, microphone and meeting language"
          }
        }
      }
    },
    "錄音存檔失敗：%@（檔案還在 %@）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save the recording: %@ (the file is still at %@)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音保存失败：%@（文件还在 %@）"
          }
        }
      }
    },
    "錄音寫不進磁碟（可能是空間不足），已經停止錄音。停止前錄到的部分有保留，會照常轉錄。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KelNote couldn't write the recording to disk (the disk may be full), so recording has stopped. Everything recorded before that is kept and will be transcribed as usual."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音写不进磁盘（可能是空间不足），已经停止录音。停止前录到的部分有保留，会照常转录。"
          }
        }
      }
    },
