            "value": "Reset Anonymous ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重置匿名 ID"
          }
        }
      }
    },
    "重試": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        }
      }
    },
    "重錄…": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重录…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record Again…"
          }
        }
      }
    },
    "重點標記 %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bookmark %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重点标记 %lld"
          }
        }
      }
    },
    "錄一場不會一直守著的線上分享、講座時，按錄音畫面計時旁邊的「定時停止」，選 1 小時後、2 小時後或「指定時間…」（例如 16:00），時間到拾音會自己停止並轉錄，暫停也照算。選單列的拾音圖示、「檔案」選單也可以設定或取消。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录一场不会一直守着的线上分享、讲座时，按录音画面计时旁边的“定时停止”，选 1 小时后、2 小时后或“指定时间…”（例如 16:00），时间到拾音会自己停止并转录，暂停也照算。菜单栏的拾音图标、“文件”菜单也可以设置或取消。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you record an online talk or lecture you won't be watching the whole time, click Stop Timer next to the clock on the recording screen and choose In 1 Hour, In 2 Hours, or At a Specific Time… (for example 16:00). Shiyin stops and transcribes the recording at that time, even while paused. You can also set or cancel it from the Shiyin icon in the menu bar or the File menu."
          }
        }
      }
    },
    "錄一段你自己的聲音，第一場會議就認得你。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录一段你自己的声音，第一场会议就认得你。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record your own voice so KelNote recognizes you from your first meeting."
          }
        }
      }
    },
    "錄一段我的聲音": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录一段我的声音"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record My Voice"
          }
        }
      }
    },
    "錄一段我的聲音…": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录一段我的声音…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record My Voice…"
          }
        }
      }
    },
    "錄下來：現場會議或線上會議，錄音時就有即時逐字稿。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record: in-person or online meetings, with a live transcript while recording."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录下来：现场会议或线上会议，录音时就有实时逐字稿。"
          }
        }
      }
    },
    "錄現場會議或你自己的聲音。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record in-person meetings or your own voice."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录现场会议或你自己的声音。"
          }
        }
      }
    },
    "錄線上會議對方的聲音用。第一次選「麥克風＋電腦聲音」錄音時 macOS 會詢問，按允許就好。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Captures the other side of online meetings. The first time you record with “Microphone + computer audio”, macOS will ask; just allow it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录线上会议对方的声音用。第一次选“麦克风＋电脑声音”录音时 macOS 会询问，按允许就好。"
          }
        }
      }
    },
    "錄線上會議時選「麥克風＋電腦聲音」：你的聲音和對方的聲音會分別錄在左右聲道。第一次錄電腦聲音時，macOS 會詢問「錄製系統音訊」的權限。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For online meetings, choose “Microphone + computer audio”: your voice and the other side are recorded on the left and right channels. The first time you record computer audio, macOS asks for System Audio Recording permission."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录线上会议时选“麦克风＋电脑声音”：你的声音和对方的声音会分别录在左右声道。第一次录电脑声音时，macOS 会询问“录制系统音频”的权限。"
          }
        }
      }
    },
    "錄製系統音訊": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System Audio Recording"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制系统音频"
          }
        }
      }
    },
    "錄過你的聲音，還沒有一起開過會議": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录过你的声音，还没有一起开过会议"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your voice is recorded; no meetings yet"
          }
        }
      }
    },
    "錄音": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音"
          }
        }
      }
    },
    "錄音 %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音 %@"
          }
        }
      }
    },
    "錄音、逐字稿和會議紀錄都只存在這台 Mac 上（~/Library/Application Support/Shiyin），不會被 iCloud 同步。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordings, transcripts and meeting notes are stored only on this Mac (~/Library/Application Support/KelNote) and aren't synced to iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音、逐字稿和会议记录都只存在这台 Mac 上（~/Library/Application Support/Shiyin），不会被 iCloud 同步。"
          }
        }
      }
    },
    "錄音一直沒辦法完整傳到企業伺服器": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording couldn't be uploaded to the enterprise server completely"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音一直没办法完整传到企业服务器"
          }
        }
      }
    },
    "錄音不會中斷，接著用這支麥克風錄；之後的錄音也用這支": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording continues with this microphone; new recordings will use it too"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音不会中断，接着用这个麦克风录；之后的录音也用这个"
          }
        }
      }
    },
    "錄音中": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音中"
          }
        }
      }
    },
    "錄音中 15 分鐘沒人說話時提醒你；再 15 分鐘還是沒人說話就自動停止，只轉錄到最後有人說話的地方，錄音檔完整保留。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KelNote reminds you after 15 minutes with nobody talking. After 15 more minutes of silence it stops recording and transcribes only up to the last speech; the full recording is kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音中 15 分钟没人说话时提醒你；再 15 分钟还是没人说话就自动停止，只转录到最后有人说话的地方，录音文件完整保留。"
          }
        }
      }
    },
    "錄音中不能錄（麥克風在用）": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音中不能录（麦克风在用）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not available while recording (the microphone is in use)"
          }
        }
      }
    },
    "錄音中在其他 app 裡也能標記重點": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bookmark while recording, even from another app"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音中在其他 app 里也能标记重点"
          }
        }
      }
    },
    "錄音中在螢幕上方正中間（有瀏海的 Mac 接在瀏海兩側）顯示錄音的時間和提醒，全螢幕開會、分享畫面時也看得到，分享畫面拍不到它。偵測到線上會議時的「要開始錄音嗎？」也在這裡。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音中在屏幕上方正中间（有浏海的 Mac 接在浏海两侧）显示录音的时间和提醒，全屏开会、分享画面时也看得到，分享画面拍不到它。检测到线上会议时的“要开始录音吗？”也在这里。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While recording, the elapsed time and alerts appear at the top center of the screen (around the notch on Macs that have one). You can see it in full-screen meetings and while sharing your screen, and screen sharing doesn't capture it. “Start recording?” for online meetings shows up here too."
          }
        }
      }
    },
    "錄音中很久沒人說話，拾音自動停止了錄音。要轉錄全部的話，用「更多 → 重新處理 → 重新轉錄」。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody spoke for a long time, so KelNote stopped recording. To transcribe everything, use More → Reprocess → Transcribe Again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音中很久没人说话，拾音自动停止了录音。要转录全部的话，用“更多 → 重新处理 → 重新转录”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音中很久沒人說話，KelNote 自動停止了錄音。要轉錄全部的話，用「更多 → 重新處理 → 重新轉錄」。"
          }
        }
      }
    },
    "錄音中按 %@ 截圖（在其他 app 裡也能用）": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音中按 %@ 截图（在其他 app 里也能用）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press %@ while recording to take a screenshot (works in other apps)"
          }
        }
      }
    },
    "錄音中按 %@ 標記重點（在其他 app 裡也能用）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While recording, press %@ to mark a highlight (works in other apps too)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音中按 %@ 标记重点（在其他 app 里也能用）"
          }
        }
      }
    },
    "錄音中標記重點": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bookmark the moment while recording"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音中标记重点"
          }
        }
      }
    },
    "錄音中畫面左邊是即時逐字稿，講完幾秒內就會出現；右邊「我的筆記」每換一行會自動記下當時的錄音時間（錄完在逐字稿分頁頂部的「我的筆記」還能改）。重要的地方按「標記重點」（⌘B），在其他 app 裡也可以按 ⌃⌥⌘B。需要中斷時按「暫停」（⇧⌘P），暫停的時間不會錄進去。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While recording, the live transcript appears on the left within seconds of speech; My notes on the right stamps the recording time on every new line (you can still edit them later under My notes at the top of the Transcript tab). Press Bookmark (⌘B) at important moments, or ⌃⌥⌘B from any app. Press Pause (⇧⌘P) to take a break; paused time is not recorded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音中画面左边是实时逐字稿，讲完几秒内就会出现；右边“我的笔记”每换一行会自动记下当时的录音时间（录完在逐字稿标签页顶部的“我的笔记”还能改）。重要的地方按“标记重点”（⌘B），在其他 app 里也可以按 ⌃⌥⌘B。需要中断时按“暂停”（⇧⌘P），暂停的时间不会录进去。"
          }
        }
      }
    },
    "錄音中螢幕上方正中間會出現錄音島（有瀏海的 Mac 接在瀏海兩側），顯示錄了多久、音量和收音提醒；滑鼠移上去可以暫停、標記重點、停止並轉錄，不用切回拾音。全螢幕開會、換桌面都看得到，分享畫面時對方看不到。不想要的話到「設定 → 錄音」關掉「在螢幕上方顯示錄音島」。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While recording, the recording island appears at the top center of the screen (on Macs with a notch, on either side of it), showing how long you've recorded, the level and any audio alerts. Hover over it to Pause, Bookmark or Stop & Transcribe without switching back to KelNote. It stays visible in full-screen meetings and on every desktop, and others can't see it when you share your screen. To turn it off, go to Settings → Recording and turn off “Show the recording island at the top of the screen”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音中屏幕上方正中间会出现录音岛（有浏海的 Mac 接在浏海两侧），显示录了多久、音量和收音提醒；鼠标移上去可以暂停、标记重点、停止并转录，不用切回拾音。全屏开会、换桌面都看得到，分享画面时对方看不到。不想要的话到“设置 → 录音”关掉“在屏幕上方显示录音岛”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音中螢幕上方正中間會出現錄音島（有瀏海的 Mac 接在瀏海兩側），顯示錄了多久、音量和收音提醒；滑鼠移上去可以暫停、標記重點、停止並轉錄，不用切回 KelNote。全螢幕開會、換桌面都看得到，分享畫面時對方看不到。不想要的話到「設定 → 錄音」關掉「在螢幕上方顯示錄音島」。"
          }
        }
      }
    },
    "錄音中顯示即時逐字稿": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show live transcript while recording"
          }
        },
        "zh-Hans": {
