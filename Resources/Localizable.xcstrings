    },
    "人多、吵雜或手機放在桌上錄音時，先告訴拾音大約幾個人，說話者會分得比較準": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With many people, noise, or a phone on the table, telling KelNote roughly how many people there are helps it tell speakers apart"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "人多、吵杂或手机放在桌上录音时，先告诉拾音大约几个人，说话者会分得比较准"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "人多、吵雜或手機放在桌上錄音時，先告訴 KelNote 大約幾個人，說話者會分得比較準"
          }
        }
      }
    },
    "人物": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "人物"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People"
          }
        }
      }
    },
    "人物分析用的模型": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model for person analysis"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "人物分析用的模型"
          }
        }
      }
    },
    "人物和利害關係人分析要讀這個人所有的會議，會議越多越長，可以用比會議紀錄更強的模型（例如 Claude Opus）。用同一個整理工具的網址和 key；另外設定時一次會多送較舊的會議。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Person and stakeholder analysis reads all of a person's meetings and grows with every meeting, so you can use a stronger model than for meeting notes (for example Claude Opus). It uses the same URL and key. When set, more of the older meetings are sent each time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "人物和利害关系人分析要读这个人所有的会议，会议越多越长，可以用比会议记录更强的模型（例如 Claude Opus）。用同一个整理工具的网址和 key；另外设置时一次会多送较旧的会议。"
          }
        }
      }
    },
    "人脈與承諾": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Network"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "人脉与承诺"
          }
        }
      }
    },
    "人際關係": {
      "extractionState": "manual",
      "localizations": {
